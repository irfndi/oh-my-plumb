{
  "name": "oh-my-plumb",
  "version": "0.2.0",
  "description": "Enforce your own AGENTS.md rules on every edit a coding agent makes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfndi/oh-my-plumb.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/irfndi/oh-my-plumb/tree/master/packages/cli",
  "author": "irfndi",
  "type": "module",
  "bin": {
    "oh-my-plumb": "dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "opencode",
    "pi",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf dist skills && tsc -p tsconfig.build.json && mkdir -p skills/oh-my-plumb-compile && cp ../../skills/oh-my-plumb-compile/SKILL.md skills/oh-my-plumb-compile/SKILL.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3",
    "ai": "^7.0.105",
    "diff": "9.0.0",
    "ink": "6.8.0",
    "ink-spinner": "5.0.0",
    "json5": "^2.2.3",
    "oh-my-plumb-schema": "workspace:*",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "smol-toml": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "8.0.0",
    "@types/node": "^20.19.0",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi/oh-my-plumb.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
