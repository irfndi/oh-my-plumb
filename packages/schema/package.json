{
  "name": "oh-my-plumb-schema",
  "version": "0.0.1",
  "description": "The oh-my-plumb contract: the rubric document a coding agent compiles from a repository's instruction files, and the verdict a check returns.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfndi/oh-my-plumb.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/irfndi/oh-my-plumb/tree/main/packages/schema",
  "author": "irfndi",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
